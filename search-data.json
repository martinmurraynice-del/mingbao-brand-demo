[{"id": "36", "title": "速溶红茶", "category": "速溶茶", "summary": "滋味浓醇鲜爽，花果香、蜜甜香\n香气浓郁，色泽黄红", "route": "/mingbao-brand-demo/Product/Info/36.html", "image": "/mingbao-brand-demo/assets/27773f90dc65509c2237.jpg"}, {"id": "35", "title": "速溶冷溶红茶", "category": "速溶茶", "summary": "工艺：纳米级陶瓷膜超滤工艺，实现产品冷水（5℃）3秒即溶。\n风味特征：汤色澄清透亮，红茶香气突出，滋味干净，产品酸稳定性好。", "route": "/mingbao-brand-demo/Product/Info/35.html", "image": "/mingbao-brand-demo/media/official/1d8357b2728bdbcf7a6a.webp"}, {"id": "32", "title": "高端抹茶", "category": "抹茶及超微茶粉", "summary": "原料：选用薮北种。\n工艺：球磨（恒温恒湿）工艺。D（60）≥800目；茶氨酸≥1.0%。\n风味特征：色泽翠绿细腻，浓郁海苔香，滋味鲜爽醇和。", "route": "/mingbao-brand-demo/Product/Info/32.html", "image": "/mingbao-brand-demo/media/official/af684f3e5e3304059c37.webp"}, {"id": "151", "title": "径山抹茶", "category": "抹茶及超微茶粉", "summary": "原料：杭州径山（抹茶发源地）的鸠坑种。\n工艺：球磨（恒温恒湿）工艺。D（60）≥800目；茶氨酸≥0.5%\n风味特征：色泽翠绿，嫩栗香持久，滋味醇和回甘。", "route": "/mingbao-brand-demo/Product/Info/151.html", "image": "/mingbao-brand-demo/media/official/1b287ab020ec50e6653b.webp"}, {"id": "31", "title": "鸭屎香浓缩液", "category": "茶植物浓缩液", "summary": "原料：鸭屎香凤凰单丛，源自潮州饶平。\n工艺：茶叶采用传统炭火复焙工艺，通过低温膜浓缩及薄膜浓缩技术相结合，缩短制作时间尽可能保留原茶花果香。产品瞬时即溶。\n风味特征：特有花果香，滋味醇厚。", "route": "/mingbao-brand-demo/Product/Info/31.html", "image": "/mingbao-brand-demo/media/official/c73fa9531c3e87dfe9e7.webp"}, {"id": "155", "title": "高香红茶浓缩液", "category": "茶植物浓缩液", "summary": "原料：高香红茶拼配。\n工艺：冷却离心工艺，使茶汤澄清保留香气和鲜爽。产品瞬时即溶。\n风味特征：蜜香浓郁，略带花香、麦芽香，滋味浓醇。", "route": "/mingbao-brand-demo/Product/Info/155.html", "image": "/mingbao-brand-demo/media/official/586fbfbdcabd88107189.webp"}, {"id": "30", "title": "龙井绿茶", "category": "原叶茶", "summary": "鲜叶采用龙井43、鸠坑等优良品种，源自浙江。", "route": "/mingbao-brand-demo/Product/Info/30.html", "image": "/mingbao-brand-demo/media/official/af502bdc2f404d52ad4e.webp"}, {"id": "156", "title": "肉桂乌龙茶", "category": "原叶茶", "summary": "独特炭焙工艺，源自福建。", "route": "/mingbao-brand-demo/Product/Info/156.html", "image": "/mingbao-brand-demo/media/official/93b049930d0f249520ba.webp"}, {"id": "158", "title": "功夫红茶", "category": "原叶茶", "summary": "工夫红茶条索紧实，增加独特的摇青工艺。", "route": "/mingbao-brand-demo/Product/Info/158.html", "image": "/mingbao-brand-demo/media/official/a99f3d926be066e45492.webp"}, {"id": "160", "title": "柑皮", "category": "代用茶", "summary": "外皮纹路紧致明显，内囊油室丰富，源自广东新会。", "route": "/mingbao-brand-demo/Product/Info/160.html", "image": "/mingbao-brand-demo/media/official/ad478fb21924e7e10744.webp"}, {"id": "161", "title": "菊花粉", "category": "植物提取物", "summary": "源自浙江桐乡的杭白菊，提取天然草本精华。", "route": "/mingbao-brand-demo/Product/Info/161.html", "image": "/mingbao-brand-demo/media/official/c3cf0c44bc2b479a5c25.webp"}, {"id": "29", "title": "酸梅汤", "category": "植物提取物", "summary": "馥郁梅香，酸甜爽口，口感醇厚，生津解渴，清爽解腻。", "route": "/mingbao-brand-demo/Product/Info/29.html", "image": "/mingbao-brand-demo/media/official/2c38f5982ea97acd8f4d.webp"}, {"id": "162", "title": "路易波士奶茶", "category": "固体饮料", "summary": "甄选南非“国宝茶”线叶金雀花，富含SOD、无咖啡因、安心睡眠，汤色琥珀红，具有温和舒适和芳香甜味的口感。", "route": "/mingbao-brand-demo/Product/Info/162.html", "image": "/mingbao-brand-demo/media/official/8c286416110650b9e271.webp"}, {"id": "163", "title": "蜜香乌龙", "category": "调味茶", "summary": "选用福建高山乌龙和蜜桃组合，蜜桃香清爽，与茶香融合口感醇和，酸甜爽口，冷热皆宜。", "route": "/mingbao-brand-demo/Product/Info/163.html", "image": "/mingbao-brand-demo/media/official/5f9fe93f0ab339c2da89.webp"}, {"id": "164", "title": "玄米黄茶", "category": "袋泡茶", "summary": "选用中焙玄米搭配黄茶，既有米香又有黄茶的锅巴香。", "route": "/mingbao-brand-demo/Product/Info/164.html", "image": "/mingbao-brand-demo/media/official/6825b471f1eeac391047.webp"}, {"id": "165", "title": "曼特宁咖啡萃取液", "category": "咖啡液/粉", "summary": "属于精品咖啡系列，优选印尼林东曼特宁咖啡豆。", "route": "/mingbao-brand-demo/Product/Info/165.html", "image": "/mingbao-brand-demo/media/official/0940ba07e17d0121f131.webp"}, {"id": "48", "title": "果茶", "category": "液体饮料应用", "summary": "蜜桃乌龙\n选用福建高山乌龙和蜜桃组合，蜜桃香清爽，与茶香融合口感醇和，酸甜爽口，冷热皆宜。", "route": "/mingbao-brand-demo/Product/Info/48.html", "image": "/mingbao-brand-demo/media/official/78c1e3cc86d009070873.webp"}, {"id": "47", "title": "果茶", "category": "液体饮料应用", "summary": "葡萄车厘子\n甄选铁观音乌龙茶，茶味清香，果味饱满，滋味足、酸甜爽口，冷热皆宜。", "route": "/mingbao-brand-demo/Product/Info/47.html", "image": "/mingbao-brand-demo/media/official/f5ef28c4800c0b5d17fc.webp"}, {"id": "46", "title": "纯茶", "category": "液体饮料应用", "summary": "鲜叶采用龙井43、鸠坑等优良品种，源自浙江。", "route": "/mingbao-brand-demo/Product/Info/46.html", "image": "/mingbao-brand-demo/media/official/bdbea158afd4fdaf5b19.webp"}, {"id": "168", "title": "奶茶", "category": "液体饮料应用", "summary": "茉莉奶茶\n选用广西茉莉花茶搭配进口牛奶，茉莉花香清新，奶香浓郁，口感清爽丝滑。", "route": "/mingbao-brand-demo/Product/Info/168.html", "image": "/mingbao-brand-demo/media/official/98d10a2f1b23449423c2.webp"}, {"id": "166", "title": "奶茶", "category": "液体饮料应用", "summary": "蜜香奶茶\n甄选优质蜜香红茶，蜜味甘醇浓淳，口感鲜爽。茶汤稠滑如琥珀，橙红透亮，色泽明丽，饱满花果明香沁人心脾。", "route": "/mingbao-brand-demo/Product/Info/166.html", "image": "/mingbao-brand-demo/media/official/39964d6c63395200217e.webp"}, {"id": "167", "title": "奶茶", "category": "液体饮料应用", "summary": "锡兰奶茶\n选用锡兰高地茶叶，汤色橙红，滋味爽口柔和，带花香，涩味较少。", "route": "/mingbao-brand-demo/Product/Info/167.html", "image": "/mingbao-brand-demo/media/official/1516423b5f1ecc383db2.webp"}, {"id": "171", "title": "植物饮料", "category": "液体饮料应用", "summary": "凉茶\n甄选仙草、菊花、甘草、鸡蛋花、夏枯草、金银花、布渣叶、红枣和罗汉果等天然草本原料，科学配比，汤色乌褐，消暑降燥、生津止渴。", "route": "/mingbao-brand-demo/Product/Info/171.html", "image": "/mingbao-brand-demo/media/official/60e18c7628d8ec79024f.webp"}, {"id": "170", "title": "植物饮料", "category": "液体饮料应用", "summary": "咖啡萃取液（桂花风味）\n桂花咖啡萃取液对乳制品包容性强、整体桂花香气宜人，咖啡、桂花、均衡柔和，互相协调。", "route": "/mingbao-brand-demo/Product/Info/170.html", "image": "/mingbao-brand-demo/media/official/b9129dea997cc8db2623.webp"}, {"id": "44", "title": "奶茶", "category": "固体饮料应用", "summary": "抹茶奶茶\n抹茶风味显，具有海苔香，与奶较融合口感顺滑醇正。", "route": "/mingbao-brand-demo/Product/Info/44.html", "image": "/mingbao-brand-demo/media/official/a644d28fa35176b05141.webp"}, {"id": "172", "title": "奶茶", "category": "固体饮料应用", "summary": "路易博士奶茶\n甄选南非“国宝茶”线叶金雀花，富含SOD、无咖啡因、安心睡眠，汤色琥珀红，具有温和舒适和芳香甜味的口感。", "route": "/mingbao-brand-demo/Product/Info/172.html", "image": "/mingbao-brand-demo/media/official/e9e26a4c75944aff9d4e.webp"}, {"id": "174", "title": "风味", "category": "固体饮料应用", "summary": "咖啡（香草）拿铁\n选用深焙咖啡粉，口感浓醇，既有咖啡的焦糖味，又有香草的薰衣草香，奶香四溢，入口微甜，带来令人愉悦的奢华口感。", "route": "/mingbao-brand-demo/Product/Info/174.html", "image": "/mingbao-brand-demo/media/official/4cb456ce8a427fcc2521.webp"}, {"id": "173", "title": "植物饮料", "category": "固体饮料应用", "summary": "酸梅汤\n精选原料萃取，科学搭配，梅香馥郁，酸甜爽口，口感醇厚，生津解渴，清爽解腻。", "route": "/mingbao-brand-demo/Product/Info/173.html", "image": "/mingbao-brand-demo/media/official/6f6a9a03a227260a36a6.webp"}, {"id": "182", "title": "抹茶冰淇淋", "category": "冷饮和烘焙糕点应用", "summary": "", "route": "/mingbao-brand-demo/Product/Info/182.html", "image": "/mingbao-brand-demo/assets/082353cbf895cf774ede.jpg"}, {"id": "176", "title": "袋泡茶", "category": "其他茶产品应用", "summary": "陈皮普洱\n原料选用新会陈皮、云南普洱；味微苦，口感醇厚，柑橘香显。", "route": "/mingbao-brand-demo/Product/Info/176.html", "image": "/mingbao-brand-demo/media/official/88519c0d6cd5e1cab74f.webp"}, {"id": "175", "title": "袋泡茶", "category": "其他茶产品应用", "summary": "玄米黄茶\n选用中焙玄米搭配黄茶，既有米香又有黄茶的锅巴香。", "route": "/mingbao-brand-demo/Product/Info/175.html", "image": "/mingbao-brand-demo/media/official/3d1358173868be1308d0.webp"}, {"id": "42", "title": "茶含片", "category": "其他茶产品应用", "summary": "茶含片", "route": "/mingbao-brand-demo/Product/Info/42.html", "image": "/mingbao-brand-demo/media/official/bd668b610c8edf8f1102.webp"}, {"id": "41", "title": "茶酒", "category": "其他茶产品应用", "summary": "茶酒", "route": "/mingbao-brand-demo/Product/Info/41.html", "image": "/mingbao-brand-demo/assets/a38dc710017cc04e1770.jpg"}, {"id": "178", "title": "茶美妆", "category": "其他茶产品应用", "summary": "茶美妆", "route": "/mingbao-brand-demo/Product/Info/178.html", "image": "/mingbao-brand-demo/media/official/fc746c293ea2bb79a35f.webp"}, {"id": "177", "title": "茶文创", "category": "其他茶产品应用", "summary": "茶文创", "route": "/mingbao-brand-demo/Product/Info/177.html", "image": "/mingbao-brand-demo/media/official/c75e1f8a8ea34633ede8.webp"}]